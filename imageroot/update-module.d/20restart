# Nach einem Update: pretix-Konfiguration neu erzeugen, neue Units laden, Dienste neu starten
# (das Laufzeit-Image kann sich geändert haben) und Konten abgleichen.

import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "pypkg"))
import termine_setup

host = os.environ.get("TRAEFIK_HOST", "")
if host:
    termine_setup.write_database_env()
    termine_setup.write_pretix_env(host)

subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
laeuft = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "termine.service"]).returncode == 0
if laeuft:
    subprocess.run(["systemctl", "--user", "restart", "termine.service"], check=True)
    subprocess.run(["termine-einrichten"], check=True)
