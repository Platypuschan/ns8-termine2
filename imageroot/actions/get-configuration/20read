import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import termine_setup


def smarthost():
    try:
        return agent.get_smarthost_settings(agent.redis_connect(use_replica=True))
    except Exception:
        return None


# Keine alten Zugangsdaten anzeigen, wenn ein Reset nach dem DB-Commit unterbrochen wurde.
termine_setup.recover_konten()

json.dump(termine_setup.configuration(
    termine_setup.read_settings(),
    termine_setup.read_konten(),
    os.getenv("TRAEFIK_HOST", ""),
    os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    os.getenv("TRAEFIK_LETS_ENCRYPT") == "True",
    smarthost(),
), fp=sys.stdout)
