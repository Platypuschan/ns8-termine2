{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Terminvergabe konfigurieren",
    "$id": "http://nethserver.org/json-schema/task/input/termine/configure-module",
    "description": "Adresse und Mailversand der Terminvergabe (pretix mit Plugin pretix_laptopbuchung)",
    "examples": [
        {
            "host": "termine.example.org",
            "http2https": true,
            "lets_encrypt": true,
            "mail_mode": "smarthost"
        },
        {
            "host": "termine.example.org",
            "http2https": true,
            "lets_encrypt": true,
            "mail_mode": "external",
            "mail_from": "terminvergabe@example.org",
            "smtp": {
                "host": "smtp.example.org",
                "port": 587,
                "username": "terminvergabe",
                "password": "geheim",
                "encryption": "starttls"
            }
        }
    ],
    "type": "object",
    "required": ["host", "http2https", "lets_encrypt"],
    "properties": {
        "host": {
            "type": "string",
            "description": "Adresse der Terminvergabe, z. B. 'termine.example.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {"type": "boolean", "title": "Let's-Encrypt-Zertifikat anfordern"},
        "http2https": {"type": "boolean", "title": "HTTP auf HTTPS umleiten"},
        "mail_mode": {
            "type": "string",
            "enum": ["smarthost", "external"],
            "description": "Mailversand über den NS8-Smarthost oder einen externen SMTP-Server; fehlt = unverändert"
        },
        "mail_from": {
            "type": "string",
            "maxLength": 254,
            "description": "Absenderadresse; leer = no-reply@<Adresse>"
        },
        "smtp": {
            "type": "object",
            "description": "Externer SMTP-Server (nur bei mail_mode 'external'); ein leeres Passwort behält das gespeicherte",
            "properties": {
                "host": {"type": "string", "maxLength": 255},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "username": {"type": "string", "maxLength": 255},
                "password": {"type": "string", "maxLength": 1024},
                "encryption": {"type": "string", "enum": ["none", "starttls", "tls"]}
            },
            "additionalProperties": false
        }
    }
}
