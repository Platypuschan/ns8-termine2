# Mail-Einstellungen speichern, Konten beim ersten Mal anlegen, pretix-Konfiguration erzeugen.

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import termine_setup

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)

termine_setup.write_database_env()
try:
    termine_setup.apply_request(data)
except termine_setup.SettingsError as error:
    agent.set_status("validation-failed")
    json.dump([{"field": error.field, "parameter": error.field, "value": error.value, "error": error.error}],
              fp=sys.stdout)
    sys.exit(2)
termine_setup.ensure_konten(data["host"])
termine_setup.write_pretix_env(data["host"])
