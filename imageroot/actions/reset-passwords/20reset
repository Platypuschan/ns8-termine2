# Neue Passwörter für ein Konto ("login") oder alle Konten erzeugen und in pretix übernehmen.

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import termine_setup

data = json.load(sys.stdin)
try:
    geaendert = termine_setup.passwoerter_neu(data.get("login") or None)
except termine_setup.SettingsError as error:
    agent.set_status("validation-failed")
    json.dump([{"field": error.field, "parameter": error.field, "value": error.value, "error": error.error}],
              fp=sys.stdout)
    sys.exit(2)
json.dump({"geaendert": geaendert}, fp=sys.stdout)
