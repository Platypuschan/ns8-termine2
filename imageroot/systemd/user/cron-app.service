# pretix' regelmäßige Aufgaben (Erinnerungen, Aufräumen) alle 5 Minuten.

[Unit]
Description=Terminvergabe Cron
BindsTo=termine.service
After=termine.service pretix-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=30
ExecStartPre=/bin/rm -f %t/cron-app.pid %t/cron-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/cron-app.pid \
    --cidfile %t/cron-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/termine.pod-id --replace -d --name cron-app \
    --env-file=%E/state/pretix.env \
    --env-file=%E/state/mail.env \
    --env CRON_INTERVALL=300 \
    --volume pretix-data:/data:z \
    ${TERMINE2_RUNTIME_IMAGE} cron-schleife
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/cron-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/cron-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/cron-app.pid
Type=forking

[Install]
WantedBy=default.target
